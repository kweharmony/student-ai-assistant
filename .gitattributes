# Настройка переносов строк для кроссплатформенной разработки

# По умолчанию Git будет конвертировать текстовые файлы в зависимости от ОС
* text=auto

# Обязательно фиксируем Linux-переносы (LF) для bash-скриптов
*.sh text eol=lf

# Ограничиваем конвертацию для файлов конфигурации Docker
Dockerfile* text eol=lf
*.yml text eol=lf

# Исключаем бинарные файлы из конвертации
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.mp3 binary
*.mp4 binary
*.wav binary
