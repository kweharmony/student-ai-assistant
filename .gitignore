# Environment variables (local overrides)
.env.local
.env.*.local

# VPN / WireGuard configs (private keys!)
*.conf
!nginx/*.conf

# Prompt files (не нужны в репозитории)
*_PROMPT.md

# Python virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.coverage
*.py[cod]
*$py.class

# Node.js
node_modules/

# Build output
build/
dist/

# Whisper models (large binary files)
whisper_models/

# Local tools (FFmpeg, Node.js — downloaded by setup)
tools/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code
.claude/
