# ============================================================
# MindeSync Frontend — React multi-stage build
# ============================================================

# ---------- Stage 1: сборка React ----------
FROM node:20-alpine AS build

WORKDIR /app

# Копируем package.json и lock-файл для кэширования npm ci
COPY package.json package-lock.json* ./
RUN npm install --silent

# Копируем исходники и собираем
COPY public/ ./public/
COPY src/ ./src/
COPY tsconfig.json tailwind.config.js postcss.config.js ./

# REACT_APP_API_URL вшивается при сборке — передаётся через docker-compose build args
ARG REACT_APP_API_URL
ENV REACT_APP_API_URL=$REACT_APP_API_URL

RUN npm run build

# ---------- Stage 2: nginx для раздачи статики ----------
FROM nginx:alpine

# Удаляем дефолтный конфиг
RUN rm /etc/nginx/conf.d/default.conf

# Копируем собранный React
COPY --from=build /app/build /usr/share/nginx/html

# Конфиг для SPA (все маршруты → index.html)
COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
