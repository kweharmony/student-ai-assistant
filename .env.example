# Скопируйте этот файл в .env и заполните своими значениями

# ==========================================
# DeepSeek API через VseLLM провайдер
# ==========================================

# API ключ VseLLM (получить на https://vsellm.ru)
# Формат: vsellm_xxxxxxxxxx
DEEPSEEK_API_KEY=vsellm_your_api_key_here

# Base URL для VseLLM API (OpenAI-compatible endpoint)
DEEPSEEK_BASE_URL=https://api.vsellm.ru/v1

# Модель DeepSeek для использования
# Доступные модели: deepseek/deepseek-v3.2, deepseek/deepseek-chat
DEEPSEEK_MODEL=deepseek/deepseek-v3.2

# ==========================================
# Настройки приложения
# ==========================================

# Режим отладки
DEBUG=True

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
