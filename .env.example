# Скопируйте этот файл в .env и заполните своими значениями
# cp .env.example .env && nano .env

# ==========================================
# DeepSeek API через VseLLM провайдер
# ==========================================
DEEPSEEK_API_KEY=vsellm_your_api_key_here
DEEPSEEK_BASE_URL=https://api.vsellm.ru/v1
DEEPSEEK_MODEL=deepseek/deepseek-v3.2

# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_USER=mindesync
POSTGRES_PASSWORD=СГЕНЕРИРОВАТЬ_КОМАНДОЙ_openssl_rand_-base64_24
POSTGRES_DB=mindesync
DATABASE_URL=postgresql+asyncpg://mindesync:ВАШ_ПАРОЛЬ@db:5432/mindesync

# ==========================================
# JWT-аутентификация
# ==========================================
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=change-me-to-random-64-char-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# CORS (домены через запятую)
# ==========================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# Frontend (вшивается при сборке React)
# ==========================================
REACT_APP_API_URL=https://ВАШ_ДОМЕН.ru

# ==========================================
# Общие
# ==========================================
DEBUG=False
LOG_LEVEL=WARNING
