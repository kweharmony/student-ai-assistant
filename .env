# ==========================================
# DeepSeek API через VseLLM провайдер
# ==========================================

# ВСТАВЬТЕ СЮДА ВАШ API КЛЮЧ от VseLLM
# Получить ключ: https://vsellm.ru
DEEPSEEK_API_KEY= sk-AH-IHMHOeCymvonbdBN7WQ

# Base URL для VseLLM (не меняйте)
DEEPSEEK_BASE_URL=https://api.vsellm.ru/v1

# Модель (не меняйте)
DEEPSEEK_MODEL=deepseek/deepseek-v3.2

# ==========================================
# Настройки приложения
# ==========================================

DEBUG=True
LOG_LEVEL=INFO

# Frontend API URL
REACT_APP_API_URL=http://localhost

# ==========================================
# PostgreSQL
# ==========================================

DATABASE_URL=postgresql+asyncpg://mindesync:mindesync_secret@localhost:5432/mindesync
POSTGRES_USER=mindesync
POSTGRES_PASSWORD=mindesync_secret
POSTGRES_DB=mindesync

# ==========================================
# Аутентификация (JWT)
# ==========================================

SECRET_KEY=change-me-to-random-64-char-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# CORS (через запятую, для продакшена)
# ==========================================

CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# Хранение файлов
# ==========================================

DATA_DIR=/data
